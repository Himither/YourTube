{
	// Ensure VSC doesn't format EVER, because the Stylus extension can be particular about formatting.
	"editor.defaultFormatter": null,
	"editor.detectIndentation": false,
	"editor.formatOnPaste": false,
	"editor.formatOnSave": false,
	"editor.formatOnType": false,
	"editor.tabSize": 8,
	"files.associations": {
		"yourtube.user.css": "stylus"
	}
}